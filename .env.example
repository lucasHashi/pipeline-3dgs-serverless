# ==============================================================================
# CONFIGURAÇÕES DO CLOUDFLARE R2 (Inserir no RunPod Endpoint > Environment Variables)
# ==============================================================================
# Endpoint do Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com

# Nome do Bucket onde o .ply será salvo
R2_BUCKET=meu-bucket-3dgs

# Token de API do Cloudflare R2 (com permissão Object Read & Write no bucket)
R2_ACCESS_KEY_ID=SEU_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=SEU_R2_SECRET_ACCESS_KEY

# Região R2 (padrão 'auto')
R2_REGION=auto

# (Opcional) Domínio público ou customizado do seu bucket R2
# Exemplo: https://pub-xxxxxxxxxxxx.r2.dev ou https://cdn.seudominio.com
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ==============================================================================
# CONFIGURAÇÕES DO CLIENTE (Para usar no client_test.py ou no seu frontend)
# ==============================================================================
RUNPOD_API_KEY=rpa_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ENDPOINT_ID=xxxxxxxxxxxxxx
